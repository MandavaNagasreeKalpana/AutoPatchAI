# AutoPatch AI configuration template.
# Copy to .env (which is git-ignored) and fill in values locally.
# Never commit real keys. Real environment variables override values in .env.

# --- Groq LLM (only required for patch generation) -------------------------
# Get a key from your Groq console. Leave empty for scanner-only use.
GROQ_API_KEY=
# A model ID available to your Groq account. No default is built into the code.
GROQ_MODEL=

# --- Patch / verification loop ---------------------------------------------
# Additional patch attempts after the first one fails verification (0-10).
AUTOPATCH_MAX_RETRIES=3

# Docker image used to run project tests in isolation.
AUTOPATCH_SANDBOX_IMAGE=autopatch-sandbox:latest
# Per-run sandbox timeout in seconds (1-3600).
AUTOPATCH_SANDBOX_TIMEOUT=120

# Allow running untrusted project code on the host when Docker is unavailable.
# Keep this false. Patches verified without Docker are reported as UNVERIFIED.
AUTOPATCH_ALLOW_HOST_EXEC=false
